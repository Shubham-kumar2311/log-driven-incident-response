# Response Service Environment Variables Reference

# Redis Configuration
USE_REDIS=false                  # true = Redis consumer mode, false = API-only mode
REDIS_HOST=localhost             # Redis host
REDIS_PORT=6379                  # Redis port

# Service API
HOST=0.0.0.0                     # Bind host
PORT=8005                        # Service port
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8005
AUTH_SERVER_URL=http://localhost:3000
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
COOKIE_NAME=auth_token

# Redis Streams
INCIDENT_STREAM=incident_events  # Input stream for incidents
RESPONSE_STREAM=response_events  # Output stream for responses
CONSUMER_GROUP=response_service_group  # Consumer group name
CONSUMER_NAME=response_worker_1        # Consumer name

# MongoDB Configuration
MONGO_URI=mongodb://localhost:27017  # MongoDB connection string
MONGO_DB=incident_response           # Database name
PLAYBOOKS_COLLECTION=playbooks       # Collection for playbooks

# Action Execution
ACTION_TIMEOUT_SECONDS=30        # Timeout for action execution
ACTION_MAX_RETRIES=3             # Number of retry attempts
ACTION_RETRY_DELAY_SECONDS=1.0   # Initial retry delay (exponential backoff)

# Logging
LOG_LEVEL=INFO                   # DEBUG, INFO, WARNING, ERROR
