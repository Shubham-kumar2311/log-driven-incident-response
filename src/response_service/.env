USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379

MONGO_URI=mongodb://localhost:27017
MONGO_DB=incident_response

INCIDENT_STREAM=incident_events
RESPONSE_STREAM=response_events
CONSUMER_GROUP=response_service_group
CONSUMER_NAME=response_worker_1

ACTION_TIMEOUT_SECONDS=30
ACTION_MAX_RETRIES=3
ACTION_RETRY_DELAY_SECONDS=1.0

LOG_LEVEL=INFO
