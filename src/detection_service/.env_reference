# ── Redis ────────────────────────────────────────────────────────
USE_REDIS=false                        # true = consume from Redis Stream, false = HTTP API mode
REDIS_HOST=localhost
REDIS_PORT=6379
INPUT_STREAM=processed_logs            # stream consumed in Redis mode
OUTPUT_STREAM=detection_signals        # stream published in Redis mode
CONSUMER_GROUP=detection-group
CONSUMER_NAME=detector-1               # unique name within the consumer group

# ── Service API ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8003

# ── Logging ──────────────────────────────────────────────────────
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR

# ── Statistical Detectors ────────────────────────────────────────
ANOMALY_Z_THRESHOLD=2.5                # z-score threshold for outlier detection
ANOMALY_MIN_SAMPLES=10                 # minimum samples before anomaly detection activates

# ── Forwarding (API mode only) ───────────────────────────────────
FORWARD_URL=                           # optional URL to POST signals (e.g. incident management)

# ── Rulebook ─────────────────────────────────────────────────────
# RULEBOOK_PATH=./rulebook.json        # override path to rulebook (default: auto-detected)

# ── Hybrid Detection / External ML ───────────────────────────────
ML_SERVICE_URL=http://localhost:9000/predict
ML_REQUEST_TIMEOUT_SECONDS=2.5         # seconds
ML_MAX_RETRIES=1                        # extra retries after first attempt
SKIP_ML_IF_RULE_TRIGGERED=false         # optional latency optimization
RUN_ML_WHEN_RULE_TRIGGERED=true         # allow CRITICAL escalation when rule+ML trigger
ML_MODE=external                        # runtime | external | hybrid
ML_RUNTIME_WARMUP_SAMPLES=25
ML_RUNTIME_ANOMALY_Z_THRESHOLD=3.0
ML_RUNTIME_MIN_STD=0.05
ML_RUNTIME_LEARN_ON_ANOMALY=false

# ── MongoDB (Detection Result Storage) ───────────────────────────
USE_MONGO=false
MONGO_URI=mongodb://localhost:27017
MONGO_DB=detection_service
DETECTION_STORE_FILE=./detection_store.jsonl