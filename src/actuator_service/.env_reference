# ═══════════════════════════════════════════════════════════════════════════════
# Actuator Service - Environment Variables Reference
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and modify as needed

# ─────────────────────────────────────────────────────────────────────────────
# REDIS CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# USE_REDIS - Enable/disable Redis consumer mode
# Values: true | false
# Default: false
# When true: Service consumes from 'response_events' stream
# When false: Service runs in API-only mode (POST /execute)
USE_REDIS=false

# REDIS_HOST - Redis server hostname
# Default: localhost
REDIS_HOST=localhost

# REDIS_PORT - Redis server port
# Default: 6379
REDIS_PORT=6379

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE API
# ─────────────────────────────────────────────────────────────────────────────

# HOST - Bind host for actuator API
HOST=0.0.0.0

# PORT - Actuator service port
PORT=8007

# RELOAD - Uvicorn reload mode for local dev
RELOAD=false

# ─────────────────────────────────────────────────────────────────────────────
# REDIS STREAMS
# ─────────────────────────────────────────────────────────────────────────────

# RESPONSE_STREAM - Input stream for response events (from Response Service)
# Default: response_events
RESPONSE_STREAM=response_events

# ACTUATOR_STREAM - Output stream for execution results
# Default: actuator_events
ACTUATOR_STREAM=actuator_events

# CONSUMER_GROUP - Redis consumer group name
# Default: actuator_service_group
CONSUMER_GROUP=actuator_service_group

# CONSUMER_NAME - Consumer instance name (unique per worker)
# Default: actuator_worker_1
CONSUMER_NAME=actuator_worker_1

# ─────────────────────────────────────────────────────────────────────────────
# EXECUTION CONFIGURATION
# ─────────────────────────────────────────────────────────────────────────────

# USE_DOCKER - Enable Docker-based execution
# Values: true | false
# Default: false
# When true: Actions like restart_database use 'docker restart <container>'
# When false: Actions use safe subprocess commands (echo simulation)
USE_DOCKER=false

# EXECUTION_TIMEOUT - Timeout for action execution (seconds)
# Default: 30
EXECUTION_TIMEOUT=30

# MAX_RETRIES - Maximum retry attempts on failure
# Default: 3
MAX_RETRIES=3

# RETRY_DELAY - Base delay between retries (seconds, uses exponential backoff)
# Default: 1.0
RETRY_DELAY=1.0

# ─────────────────────────────────────────────────────────────────────────────
# DOCKER CONTAINER NAMES (when USE_DOCKER=true)
# ─────────────────────────────────────────────────────────────────────────────

# DOCKER_DB_CONTAINER - Database container name
# Default: db-container
DOCKER_DB_CONTAINER=db-container

# DOCKER_API_CONTAINER - API container name
# Default: api-container
DOCKER_API_CONTAINER=api-container

# DOCKER_CACHE_CONTAINER - Cache (Redis/Memcached) container name
# Default: cache-container
DOCKER_CACHE_CONTAINER=cache-container

# DOCKER_WORKER_CONTAINER - Worker service container name
# Default: worker-container
DOCKER_WORKER_CONTAINER=worker-container

# ─────────────────────────────────────────────────────────────────────────────
# SERVICE API URLS (for service-call mode)
# ─────────────────────────────────────────────────────────────────────────────

# SERVICE_API_BASE - Base URL for application API
# Default: http://localhost:8005
SERVICE_API_BASE=http://localhost:8005

# AUTH_SERVICE_URL - Authentication service URL (for lock_accounts)
# Default: http://localhost:3000
AUTH_SERVICE_URL=http://localhost:3000

# NOTIFICATION_SERVICE_URL - Notification service URL
# Default: http://localhost:8006
NOTIFICATION_SERVICE_URL=http://localhost:8006

# ─────────────────────────────────────────────────────────────────────────────
# LOGGING & HISTORY
# ─────────────────────────────────────────────────────────────────────────────

# LOG_LEVEL - Logging verbosity
# Values: DEBUG | INFO | WARNING | ERROR
# Default: INFO
LOG_LEVEL=INFO

# MAX_HISTORY_SIZE - Maximum execution history entries to keep in memory
# Default: 100
MAX_HISTORY_SIZE=100
