# Central Auth Server Configuration

# Server
AUTH_HOST=0.0.0.0
AUTH_PORT=3000
DEBUG=true
LOG_LEVEL=INFO

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=auth_db

# JWT - CHANGE IN PRODUCTION!
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# Cookie
COOKIE_NAME=auth_token
COOKIE_MAX_AGE=3600
COOKIE_SECURE=false
COOKIE_HTTPONLY=true
COOKIE_SAMESITE=lax

# Bcrypt
BCRYPT_ROUNDS=12

# Detection Service
DETECTION_SERVICE_URL=http://localhost:8003/detect

# CORS and role redirects
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8001,http://localhost:8004,http://localhost:8005,http://localhost:8006,http://localhost:8007
ROLE_REDIRECT_USER=http://localhost:8001
ROLE_REDIRECT_ANALYST=http://localhost:8004
ROLE_REDIRECT_ADMIN=http://localhost:8005

# Brute-force tuning
BRUTE_FORCE_THRESHOLD=5
BRUTE_FORCE_WINDOW_SECONDS=120
