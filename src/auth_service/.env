# Central Auth Server Configuration

# Server
AUTH_HOST=0.0.0.0
AUTH_PORT=3000
DEBUG=true

# MongoDB
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB=auth_db

# JWT - CHANGE IN PRODUCTION!
JWT_SECRET=super-secret-key-change-in-production
JWT_EXPIRE_MINUTES=60

# Cookie
COOKIE_SECURE=false

# Bcrypt
BCRYPT_ROUNDS=12

# Detection Service
DETECTION_SERVICE_URL=http://localhost:8003/detect

# Logging
LOG_LEVEL=INFO
