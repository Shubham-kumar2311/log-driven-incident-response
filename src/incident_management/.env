USE_REDIS=false
REDIS_HOST=localhost
REDIS_PORT=6379
INPUT_STREAM=detection_signals
OUTPUT_CHANNEL=incident_events
CONSUMER_GROUP=incident-group
CONSUMER_NAME=incident-mgr-1

HOST=0.0.0.0
PORT=8004
CORS_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,http://localhost:8004
AUTH_SERVER_URL=http://localhost:3000
JWT_SECRET=super-secret-key-change-in-production
JWT_ALGORITHM=HS256
COOKIE_NAME=auth_token

# MongoDB (set USE_MONGO=true to enable)
USE_MONGO=true
MONGO_URI=mongodb://localhost:27017
MONGO_DB=incident_management

# Correlation
CORRELATION_WINDOW_SECONDS=300

# Severity
CRITICAL_RISK_THRESHOLD=0.9
CRITICAL_SIGNAL_COUNT=5
HIGH_SIGNAL_COUNT=3
CRITICAL_SERVICES=auth-service,payment-service,database

# Forwarding (to response service, optional)
FORWARD_URL=

# Logging
LOG_LEVEL=INFO
