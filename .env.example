# Environment Configuration for Testing
# Copy this file to .env and update with your actual service URLs

# Microservice URLs
AUTH_SERVICE_URL=http://localhost:5000
INCIDENT_SERVICE_URL=http://localhost:5001
DETECTION_SERVICE_URL=http://localhost:5002
LOG_INGESTION_URL=http://localhost:5003
LOG_PROCESSING_URL=http://localhost:5004

# Test Credentials
TEST_USERNAME=testuser
TEST_PASSWORD=testpass123
TEST_EMAIL=testuser@example.com

# Logging
LOG_LEVEL=INFO
LOG_FORMAT=json

# Testing
TEST_TIMEOUT=10
TEST_RETRIES=3
PYTEST_VERBOSITY=-v

# Optional: Disable SSL verification for self-signed certificates
REQUESTS_VERIFY_SSL=true
